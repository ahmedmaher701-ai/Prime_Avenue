rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com'; }
  function admin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
  function resident() { return signedIn() && get(/databases/$(database)/documents/residents/$(request.auth.uid)).data.status == 'approved'; }
  function member() { return admin() || resident(); }
  function visible(id) { return member() && (admin() || get(/databases/$(database)/documents/posts/$(id)).data.visibility == 'published' || get(/databases/$(database)/documents/posts/$(id)).data.authorId == request.auth.uid); }
  match /admins/{uid} { allow get: if signedIn() && request.auth.uid == uid; }
  match /residents/{uid} { allow get: if signedIn() && (request.auth.uid == uid || admin()); allow list: if admin(); }
  match /posts/{id} {
   allow read: if member() && (admin() || resource.data.visibility == 'published' || resource.data.authorId == request.auth.uid);
   match /comments/{commentId} { allow read: if visible(id); }
   match /responses/{uid} { allow get: if visible(id) && request.auth.uid == uid; allow list: if admin(); }
  }
  match /notifications/{uid}/items/{id} { allow read: if signedIn() && request.auth.uid == uid; }
  // All mutations go through authenticated, App Check protected Cloud Functions.
  match /{document=**} { allow write: if false; }
 }
}
